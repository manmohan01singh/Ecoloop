# Environment
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoloop
DB_USER=ecoloop
DB_PASSWORD=ecoloop_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=ecoloop_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ecoloop_refresh_secret_key_2026_change_in_production
