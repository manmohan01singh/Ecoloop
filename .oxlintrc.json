{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "env": {
    "browser": true,
    "builtin": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["backend/**/*.js", "backend/**/*.mjs", "tests/**/*.js", "tests/**/*.mjs", "*.js", "*.cjs", "*.mjs"],
      "env": {
        "node": true
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "mobile/**",
    "node_modules/**"
  ]
}
